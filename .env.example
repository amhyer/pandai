# ═══════════════════════════════════════════════════
# PANDAI — Environment Configuration
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control!
# ═══════════════════════════════════════════════════

# ─── Database ───
# SQLite (development / small-scale deployment):
DATABASE_URL=file:./db/custom.db
# PostgreSQL (production recommended for multi-school):
# DATABASE_URL=postgresql://user:password@host:5432/pandai_db

# ─── Security ───
# MUST change in production! Generate with:
#   ./scripts/generate-credentials.sh
# Expected: 64 hex characters (`openssl rand -hex 32`).
JWT_SECRET=replace_with_openssl_rand_hex_32
# Legacy SHA-256 password salt. Keep using the same generated salt for migrations;
# never hardcode, never commit, and rotate it if it was ever exposed.
PASSWORD_SALT=replace_with_openssl_rand_hex_32

# ─── App ───
NODE_ENV=production

# ─── AI Provider (optional, for AI features) ───
# Z-AI Web Dev SDK is used via backend imports.
# No separate API key needed if using the built-in SDK.
# If using OpenAI directly (not recommended), uncomment:
# OPENAI_API_KEY=sk-...

# ─── Rate Limiter (optional, recommended for production) ───
# Enables a distributed in-memory-free rate limiter behind Upstash REST.
# If not set, the app falls back to a process-local rate limiter.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_token

# ─── Google Sheets Sync (optional) ───
# Kunci AES-256-GCM untuk menyimpan token OAuth2 Google secara terenkripsi di DB.
# Generate dengan: openssl rand -hex 32 (atau ./scripts/generate-credentials.sh)
# AES_SECRET=replace_with_openssl_rand_hex_32
#
# OAuth 2.0 credentials dari Google Cloud Console (Desktop app / Web app).
# Lihat docs/GOOGLE_SHEETS_SYNC_SETUP.md untuk langkah lengkap.
# GOOGLE_SHEETS_CLIENT_ID=replace_with_google_client_id
# GOOGLE_SHEETS_CLIENT_SECRET=replace_with_google_client_secret
# GOOGLE_SHEETS_REDIRECT_URI=https://app-domainmu/api/sheets/oauth/callback
#
# Shared secret untuk cron sinkronisasi otomatis (Vercel Cron / eksternal).
# SHEETS_SYNC_CRON_SECRET=replace_with_openssl_rand_hex_32
#
# Di Vercel: set JUGA env CRON_SECRET dengan nilai yang sama — Vercel Cron
# otomatis mengirim header "Authorization: Bearer $CRON_SECRET" pada GET
# /api/sheets/sync (lihat docs/GOOGLE_SHEETS_SYNC_SETUP.md bagian cron).
# CRON_SECRET=replace_with_nilai_sama_dengan_SHEETS_SYNC_CRON_SECRET
