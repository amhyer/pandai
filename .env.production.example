# ═══════════════════════════════════════════════════════════════
# PANDAI — Template environment PRODUCTION (cPanel / VPS)
# Salin lalu isi:  cp .env.production.example .env.production
# File ini BOLEH di-commit (tidak berisi rahasia).
# JANGAN pernah commit .env.production yang sudah diisi!
# ═══════════════════════════════════════════════════════════════

# ─── WAJIB ───
# PostgreSQL dari cPanel (host biasanya 127.0.0.1)
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/nama_db

# Kredensial aplikasi — generate: bash scripts/generate-credentials.sh --show
# (atau manual: openssl rand -hex 32, dua nilai berbeda)
JWT_SECRET=
# ⚠️ PERMANEN: semua password legacy (SHA-256) diverifikasi dengan salt ini.
# Jangan ubah setelah ada user terdaftar!
PASSWORD_SALT=

# URL publik aplikasi — dibaca SAAT BUILD (di-inline ke bundle client).
# Salah saat build = harus build ulang. Tanpa trailing slash.
NEXT_PUBLIC_APP_URL=https://domain-anda.com

# ─── OPSIONAL ───
# Rate limit terdistribusi multi-instance (kosong = in-memory per proses)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Super admin pertama (Langkah 8 runbook). Kosong = password acak dicetak
# sekali ke terminal saat create-super-admin dijalankan.
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_PASSWORD=

# ─── GOOGLE SHEETS SYNC (opsional — docs/GOOGLE_SHEETS_SYNC_SETUP.md) ───
# Kunci enkripsi token OAuth2 di DB — WAJIB di production jika fitur dipakai.
# AES_SECRET=
# GOOGLE_SHEETS_CLIENT_ID=
# GOOGLE_SHEETS_CLIENT_SECRET=
# GOOGLE_SHEETS_REDIRECT_URI=https://domain-anda.com/api/sheets/oauth/callback
# Cron sinkronisasi terjadwal (external cron):
# SHEETS_SYNC_CRON_SECRET=

# ─── FITUR AI (opsional) ───
# Tidak lewat env — buat file `.z-ai-config` di application root:
# {"baseUrl": "https://.../v1", "apiKey": "..."}
