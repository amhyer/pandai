// ─── Main Page ─────────────────────────────────────────────────────

export default function Home() {
  const isAuthenticated = useAppStore((s) => s.isAuthenticated);
  const currentView = useAppStore((s) => s.currentView);

  if (!isAuthenticated) {
    switch (currentView) {
      case 'login':
        return <LoginForm />;
      case 'register':
        return <RegisterForm />;
      case 'landing':
      default:
        return <LandingPageInline />;
    }
  }

  return <AuthenticatedApp />;
}
